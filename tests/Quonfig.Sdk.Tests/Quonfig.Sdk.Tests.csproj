<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net8.0 — modern host. Consumes the net8.0 build of Quonfig.Sdk.
      net48  — .NET Framework 4.8 host. Consumes the netstandard2.0 build of Quonfig.Sdk
               (via NuGet TFM preference rules). Windows-only at runtime; restore works on all OSes.
    -->
    <TargetFrameworks>net8.0;net48</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- CA1707: snake_case test method names. CA2007: ConfigureAwait noise in tests.
         CA1861: constant array args are clearer than static-readonly fields in assertions. -->
    <!-- CS0618: the generated integration cases (get_or_raise.yaml "deprecated on_init_failure
         raise/return") deliberately exercise the [Obsolete] OnInitFailure.Throw / ReturnDefaults aliases. -->
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1861;CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="WireMock.Net.Minimal" />
  </ItemGroup>

  <!-- The .NET SDK adds this package implicitly for net48 only where the 4.8 targeting pack is not
       installed (Linux/macOS, not windows runners), which made packages.lock.json differ by OS and
       locked-mode restore fail on windows (NU1004). Referencing it explicitly makes the graph the
       same everywhere; it is the same package and version the SDK adds (qfg-66ko.19). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
    <!-- WireMock.Net.Minimal 2.x -> Scriban.Signed 7.x needs System.Text.Json >= 10.0.8 on
         netstandard2.0, above the SDK's 8.0.6 central pin. Raised here only, for the net48 test
         host; the published Quonfig.Sdk packages keep the 8.0.6 floor (qfg-66ko.19). -->
    <PackageReference Include="System.Text.Json" VersionOverride="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Quonfig.Sdk\Quonfig.Sdk.csproj" />
  </ItemGroup>

</Project>
